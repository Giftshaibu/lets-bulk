{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giftshaibu-lets-bulk",
  "account_id": "848d59667703c18094f22c7cece45532",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "PUSH_ENABLED": "true",
    "VAPID_PUBLIC_KEY": "BLK4cmpwju2rNI9Qf-SoIPcuod2dzmpK7Xzx8sUry3CUZDLdK9R1RVcIi09viHCPvOhGn2eNvNlX-s1tY8A3wNE",
    "AI_ENABLED": "false",
    "AI_FREE_TIER_CONFIRMED": "false",
    "CLOUDFLARE_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
  },
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "placement": { "region": "aws:eu-west-1" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
